# Copy this file to .env and adjust as needed.
# NEVER commit .env — it is gitignored.

# Target environment
BASE_URL=https://automationexercise.com
API_URL=https://automationexercise.com/api

# AI RCA (optional). Leave blank to use the deterministic fallback.
AI_PROVIDER=            # openai | anthropic | azure | (blank)
AI_API_KEY=             # NEVER commit. Set in CI secrets.
AI_MODEL=               # e.g. gpt-4o-mini | claude-3-5-sonnet-latest
AI_BASE_URL=            # optional for Azure/proxy
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.2

# Test execution
CI=false